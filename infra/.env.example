# Non-secret template only (01A §5.4, Rule 13).
# Copy to infra/.env only for ephemeral local runs, OR encrypt with SOPS+age into infra/.env.sops.yaml for staging.

ASPNETCORE_ENVIRONMENT=Development
API_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
AUTH_DOMAIN=auth.localhost
GRAFANA_DOMAIN=grafana.localhost

OIDC_ISSUER_URL=http://keycloak:8080/realms/farm-basics
AUTH_REQUIRE_HTTPS_METADATA=false

VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_AUTHORITY=http://localhost:8180/realms/farm-basics
VITE_KEYCLOAK_CLIENT_ID=farm-basics-admin
VITE_APP_URL=http://admin.localhost:8080

POSTGRES_USER=farmbasics_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_OR_SOPS
KEYCLOAK_ADMIN_USER=kc_bootstrap_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LOCAL_OR_SOPS
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME_LOCAL_OR_SOPS
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_32_BYTE_BASE64_VIA_SOPS
GRAFANA_ADMIN_USER=grafana_ops
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_OR_SOPS
